<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="top|center_horizontal"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="0dp"
    android:paddingEnd="6dp"
    android:paddingBottom="0dp">

    <!-- 厂商标题 (居中展示，顶对齐) -->
    <TextView
        android:id="@+id/providerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Antigravity"
        android:textColor="@color/column_title"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- 环形进度条区域 (各厂商保持一致高度和外边距) -->
    <FrameLayout
        android:id="@+id/ringContainer"
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp">

        <app.agentring.android.ui.ActivityRingView
            android:id="@+id/activityRingView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- 动态胶囊药丸容器 (垂直排列，各列顶对齐) -->
    <LinearLayout
        android:id="@+id/rowsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
